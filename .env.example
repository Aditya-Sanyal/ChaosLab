# CHAOS LAB environment configuration
# Copy to .env for local or Docker Compose overrides; never commit real secrets.

# Runtime environment mode: development | test | production
CHAOSLAB_ENV=development

# Relational database connection URL
# Local zero-install default uses SQLite; PostgreSQL uses postgresql+psycopg://...
CHAOSLAB_DATABASE_URL=sqlite:///./data/chaoslab.db

# Cryptographic secret key (production mode requires >= 32 characters and non-default value)
CHAOSLAB_SECRET_KEY=dev-only-change-me-in-production

# Cookie security flags:
# - Local HTTP (http://127.0.0.1:8080 or http://localhost:5173): false
# - Public/LAN behind HTTPS reverse proxy: true
CHAOSLAB_COOKIE_SECURE=false

# Allowed CORS origins (JSON list; same-origin /api proxy does not need broad CORS)
CHAOSLAB_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]

# Retention defaults (days)
CHAOSLAB_RETENTION_SNAPSHOTS_DAYS=180
CHAOSLAB_RETENTION_RUNS_DAYS=365
CHAOSLAB_RETENTION_SESSIONS_GRACE_DAYS=30
CHAOSLAB_RETENTION_AUDIT_DAYS=730

# Docker Compose settings
# Set CHAOSLAB_AUTO_SEED_DEMO=false in real/production deployments and bootstrap via `create-admin`.
# Keep POSTGRES_PASSWORD URL-safe (letters/digits/-/_; avoid @ : / ? # %) so the URI parses cleanly.
CHAOSLAB_PORT=8080
CHAOSLAB_AUTO_SEED_DEMO=false
POSTGRES_DB=chaoslab
POSTGRES_USER=chaoslab
POSTGRES_PASSWORD=change-me-postgres-password
